# Copy this file to .env. Existing process environment variables take precedence.
# go-zero services use service-owned databases and accounts.
IDENTITY_DATABASE_DSN=identity_dev:identity_dev_pw_2026@tcp(localhost:3307)/cityflow_identity?parseTime=true&charset=utf8mb4&loc=UTC
TASK_DATABASE_DSN=task_dev:task_dev_pw_2026@tcp(localhost:3307)/cityflow_task?parseTime=true&charset=utf8mb4&loc=UTC
PAYMENT_DATABASE_DSN=payment_dev:payment_dev_pw_2026@tcp(localhost:3307)/cityflow_payment?parseTime=true&charset=utf8mb4&loc=UTC
REACTION_DATABASE_DSN=reaction_dev:reaction_dev_pw_2026@tcp(localhost:3307)/cityflow_reaction?parseTime=true&charset=utf8mb4&loc=UTC
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0
AUTH_STATUS_CACHE_TTL_SECONDS=5
CITYFLOW_JWT_SECRET=replace-this-local-development-secret
CITYFLOW_SEED_DEMO=true
DATABASE_MAX_OPEN_CONNS=12
DATABASE_MAX_IDLE_CONNS=4
DATABASE_CONN_MAX_IDLE_SECONDS=300
DATABASE_CONN_MAX_LIFETIME_SECONDS=1800

# Map tiles: keep provider attribution and observe its usage policy.
# Optional persistent map settings: copy map.local.example.json to map.local.json.
# Environment values override that JSON, including explicit empty values.
# MAP_PROVIDER=amap
# Map data source: local reads the Guilin layers from PostGIS, amap keeps the
# original online services, hybrid prefers amap and falls back to local when
# the online call fails or is empty. Rendering (provider/tile_url) is independent.
# MAP_SERVICE_PROVIDER=hybrid
# MAP_POSTGIS_DSN=postgres://cityflow:cityflow_map_dev@127.0.0.1:5434/cityflow_map?sslmode=disable
# Change city, adcode and WGS84 center together.
# MAP_DEFAULT_CITY=桂林市
# MAP_DEFAULT_ADCODE=450300
# MAP_DEFAULT_LATITUDE=25.274
# MAP_DEFAULT_LONGITUDE=110.290
# MAP_HOT_CITIES=450300,桂林,桂林市
# AMAP_JS_KEY=your-web-js-api-key
# AMAP_SECURITY_CODE=your-js-security-code
# AMAP_WEB_SERVICE_KEY=your-web-service-key
# Optional OSRM bicycle instance; the default public demo is for development.
# MAP_MATCH_URL=https://your-bicycle-osrm.example.com
# MAP_MATCH_URL=disabled
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
# Compose port overrides (when starting containers, not loaded by the Go API).
MYSQL_PORT=3307
REDIS_PORT=6380
POSTGIS_PORT=5434
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# RabbitMQ integration events. Leave empty to keep outbox rows pending and use
# the local synchronous fallback for rider approval; set it for Task/Payment MQ.
RABBITMQ_URL=amqp://cityflow:replace-this-local-rabbitmq-password@localhost:5673/cityflow
# Used by scripts/mq/mq-status.ps1 and scripts/mq/e2e-payment.ps1.
RABBITMQ_MANAGEMENT_URL=http://localhost:15673

# Optional local multi-instance overrides. The start-local.ps1 -PaymentInstances
# flag sets these per process; leave them unset for the normal single instance.
# PAYMENT_LISTEN_ON=127.0.0.1:8096
# All instances may run settlement and inbox recovery because claims use
# FOR UPDATE SKIP LOCKED. Keep reconciliation on one instance until its scans
# have their own leases; start-local.ps1 already does this.
PAYMENT_SETTLEMENT_WORKER_ENABLED=true
PAYMENT_RECONCILIATION_WORKER_ENABLED=true
PAYMENT_INBOX_RECOVERY_WORKER_ENABLED=true
# GATEWAY_PAYMENT_RPC_ENDPOINTS=127.0.0.1:8094,127.0.0.1:8096
# TASK_PAYMENT_RPC_ENDPOINTS=127.0.0.1:8094,127.0.0.1:8096

# Map namespace payload + metadata budget, not global Redis maxmemory.
MAP_CACHE_MB=128
# Provider calls across instances sharing Redis; per-process fallback on outage.
MAP_PROVIDER_REQUESTS_PER_MINUTE=60
# Enable provider response caching ONLY when authorized by the relevant Amap terms.
# False still enables request coalescing and quotas, but stores no provider responses.
MAP_AMAP_CACHE_ALLOWED=false
# Applied only with the permission switch above; stale boundary window = TTL / 4.
MAP_DISTRICT_TTL_SECONDS=3600
MAP_SEARCH_TTL_SECONDS=60
MAP_CITY_TTL_SECONDS=600
MAP_ROUTE_TTL_SECONDS=60

# Search results use Redis only, with a one-minute TTL; there is no MySQL
# place-query cache and no account identifier in the cache key.

# Trusted POI retention: verify this duration against your Amap service terms.
TRUSTED_PLACE_TTL_SECONDS=1800

# --- Payment ----------------------------------------------------------------
# MOCK needs no credentials and is the default: create-payment returns
# cityflow-mock://pay/<orderNo>, and POST /payments/{id}/mock-pay walks the
# same state machine as a real callback. Real providers return 503 until
# their credentials below are filled in; they never fake success.
CITYFLOW_PAYMENT_PROVIDER=MOCK
# Platform fee in basis points (0 = rider receives the full quote, 10000 = 100%).
CITYFLOW_PAYMENT_FEE_BPS=0
CITYFLOW_PAYMENT_EXPIRE_MINUTES=30
CITYFLOW_PAYMENT_ALLOW_MOCK_PAY=true
CITYFLOW_PAYMENT_SETTLE_INTERVAL_SECONDS=30
# Public HTTPS origin used to derive provider notify URLs:
# <base>/api/v1/payment-notify/alipay and .../wechat
CITYFLOW_PAYMENT_NOTIFY_BASE_URL=
# Optional; only used by the mock QR payload (default cityflow-mock://pay).
CITYFLOW_PAYMENT_MOCK_BASE_URL=

# Alipay openapi v2 (sandbox by default). Keys accept a file path or an inline
# PEM value with literal \n escapes; a file is strongly preferred.
# ALIPAY_APP_ID=
# ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# ALIPAY_NOTIFY_URL=
# ALIPAY_PRIVATE_KEY_FILE=configs/keys/alipay_app_private.pem
# ALIPAY_PUBLIC_KEY_FILE=configs/keys/alipay_public.pem

# WeChat Pay API v3. APIv3Key must be 32 characters (or base64 of 32 bytes).
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_SERIAL_NO=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_NOTIFY_URL=
# WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
# 佣金报酬场景的 transfer_scene_id，需在商户平台确认后填写。
# WECHAT_PAY_TRANSFER_SCENE_ID=1000
# WECHAT_PAY_PRIVATE_KEY_FILE=configs/keys/wechat_apiclient_key.pem
# WECHAT_PAY_PLATFORM_PUBLIC_KEY_FILE=configs/keys/wechat_platform_public.pem

